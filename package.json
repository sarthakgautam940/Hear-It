{
  "name": "hear-it",
  "version": "0.1.0",
  "private": true,
  "description": "Hear It makes a quiet voice carry across the table and shows how far it reaches.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/build-audio.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/build-audio.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
