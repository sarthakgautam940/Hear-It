{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "webworker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/platform/sw/**/*.ts"]
}
